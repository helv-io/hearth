<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.helv.Hearth</id>
  <name>Hearth</name>
  <summary>Edit an iPhone or iPad home screen</summary>
  <developer id="io.helv">
    <name>helv.io</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Read a home screen over USB, rearrange pages, folders, widgets, and the dock, then send it back.</p>
    <p>Works with a current iPhone or iPad. A send is read back, and the previous layout is restored when the device does not keep the edit.</p>
    <p>Hearth needs the USB service for iPhones and iPads, called usbmuxd, to be running on this computer. Most Linux systems have it, or have a package of that name.</p>
    <p>Hearth checks once a day whether a newer version exists. That is the only thing it sends on its own. You can turn it off in Settings.</p>
  </description>
  <launchable type="desktop-id">io.helv.Hearth.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#d5e3f5</color>
    <color type="primary" scheme_preference="dark">#1f2933</color>
  </branding>
