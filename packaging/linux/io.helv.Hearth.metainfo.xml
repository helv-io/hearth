<component type="desktop-application">
  <id>io.helv.Hearth</id>
  <name>Hearth</name>
  <summary>Edit an iPhone or iPad home screen</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Read a home screen over USB, rearrange pages, folders, widgets, and the dock, then send it back.</p>
    <p>Works with a current iPhone or iPad. A send is read back, and the previous layout is restored when the device does not keep the edit.</p>
    <p>On Linux and Windows, Hearth installs the USB service when it is missing. macOS already has it.</p>
  </description>
  <launchable type="desktop-id">io.helv.Hearth.desktop</launchable>
